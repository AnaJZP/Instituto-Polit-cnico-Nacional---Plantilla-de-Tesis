\ProvidesPackage{thesis}

% ---------- Idioma, codificación y letra ----------
\usepackage[T1]{fontenc}                      % Acentos y caracteres especiales
\usepackage[utf8]{inputenc}                   % Archivos en UTF-8
\usepackage[spanish,mexico]{babel}            % Español de México («Tabla», «Capítulo»)
\usepackage{mathptmx}                         % Times en texto y ecuaciones
\usepackage[final]{microtype}                 % Mejor justificación del texto
\emergencystretch=1em

% ---------- Página: carta, márgenes 2.5 cm (sup./inf.) y 3 cm (izq./der.) ----------
\usepackage[letterpaper, top=25mm, bottom=25mm, left=30mm, right=30mm]{geometry}

% ---------- Interlineado 1.5, sin sangría, espacio entre párrafos ----------
\usepackage{setspace}
\onehalfspacing
\setlength{\parindent}{0cm}
\setlength{\parskip}{0.6\baselineskip}

% ---------- Paquetes generales ----------
\usepackage{graphicx}                         % Imágenes
\usepackage[dvipsnames]{xcolor}               % Colores
\usepackage{float}                            % Posición de tablas y figuras ([H])
\usepackage{array, booktabs, multirow, makecell, longtable}  % Tablas
\usepackage{pdflscape}                        % Páginas horizontales para tablas anchas
\usepackage{amsmath, amssymb, bm}             % Ecuaciones
\usepackage{enumitem}                         % Listas
\setlist[itemize]{noitemsep, topsep=0pt}
\setlist[enumerate]{noitemsep, topsep=0pt}
\usepackage{pgfplots}                         % Gráficas hechas en LaTeX (editables)
\pgfplotsset{compat=1.18}
\usepackage[most]{tcolorbox}                  % Recuadros de guía
\usepackage{pdfpages}                         % Insertar PDF de las actas firmadas: \includepdf{archivo.pdf}
\usepackage{url}
\usepackage[hidelinks]{hyperref}              % Enlaces en el índice y en las citas

% ---------- Tablas y figuras en formato APA 7 ----------
% Arriba: «Tabla 1» en negritas y, en el renglón siguiente, el título en cursiva.
\usepackage{caption}
\captionsetup{labelfont=bf, textfont=it, labelsep=newline, justification=raggedright,
              singlelinecheck=false, position=top, skip=4pt, font={stretch=1.1}}
\usepackage{chngcntr}
\counterwithout{table}{chapter}               % Tabla 1, 2, 3… en todo el documento
\counterwithout{figure}{chapter}
% Nota debajo de tablas y figuras:  \nota{Elaboración propia con datos de…}
\newcommand{\nota}[1]{\par\vspace{2pt}{\small\setstretch{1}\textit{Nota.} #1\par}}

% ---------- Ecuaciones numeradas (1), (2)… en todo el documento ----------
\counterwithout{equation}{chapter}
\renewcommand\theequation{\arabic{equation}}

% ---------- Títulos (niveles APA 7) ----------
% Nivel 1 (capítulos y apartados): centrado, negritas.  «Capítulo 1. Marco teórico»
% Nivel 2 (\section): izquierda, negritas, numerado 1.1
% Nivel 3 (\subsection): izquierda, negritas y cursivas, numerado 1.1.1
\usepackage{titlesec}
\titleformat{\chapter}[block]{\normalfont\large\bfseries\centering}{\chaptertitlename~\thechapter.}{0.4em}{}
\titleformat{name=\chapter,numberless}[block]{\normalfont\large\bfseries\centering}{}{0pt}{}
\titlespacing*{\chapter}{0pt}{0pt}{1.2\baselineskip}
\titleformat{\section}[hang]{\normalfont\normalsize\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}[hang]{\normalfont\normalsize\bfseries\itshape}{\thesubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.2\baselineskip}{0.3\baselineskip}
\titlespacing*{\subsection}{0pt}{1\baselineskip}{0.3\baselineskip}
\setcounter{secnumdepth}{2}

% ---------- Índices ----------
\addto\captionsspanish{%
  \renewcommand{\contentsname}{Índice}%
  \renewcommand{\listtablename}{Índice de tablas}%
  \renewcommand{\listfigurename}{Índice de figuras}%
  \renewcommand{\bibname}{Referencias}%
  \renewcommand{\tablename}{Tabla}}
\usepackage{tocloft}
\renewcommand{\cfttoctitlefont}{\hfill\large\bfseries}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\large\bfseries}
\renewcommand{\cftafterlottitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\large\bfseries}
\renewcommand{\cftafterloftitle}{\hfill}
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftbeforelottitleskip}{0pt}
\setlength{\cftbeforeloftitleskip}{0pt}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftchappresnum}{\chaptername~}
\renewcommand{\cftchapaftersnum}{.}
\settowidth{\cftchapnumwidth}{\bfseries\chaptername~9.\quad}
\renewcommand{\cfttabpresnum}{\bfseries Tabla~}
\renewcommand{\cfttabaftersnum}{.}
\settowidth{\cfttabnumwidth}{\bfseries Tabla~99.\quad}
\renewcommand{\cftfigpresnum}{\bfseries Figura~}
\renewcommand{\cftfigaftersnum}{.}
\settowidth{\cftfignumwidth}{\bfseries Figura~99.\quad}
\setlength{\cfttabindent}{0pt}
\setlength{\cftfigindent}{0pt}
\setlength{\cftbeforechapskip}{0.5em}
\setcounter{tocdepth}{2}

% Apartado sin número que sí aparece en el índice:  \apartado{Resumen}
\newcommand{\apartado}[1]{\clearpage\phantomsection\addcontentsline{toc}{chapter}{#1}\chapter*{#1}}

% Hoja institucional que no va en el índice (actas, carta cesión, dedicatoria…)
\newcommand{\hojainstitucional}[2]{\clearpage
  {\centering\large\bfseries #1\par}\vspace{\baselineskip}
  {\centering\color{gray}\itshape #2\par}}

% ---------- Recuadros de guía (bórralos o desactívalos en tu versión final) ----------
% Para ocultar TODAS las guías de una vez, escribe \mostrarguiasfalse en Principal.tex.
\newif\ifmostrarguias \mostrarguiastrue
\newcommand{\guia}[1]{\ifmostrarguias
  \begin{tcolorbox}[enhanced, breakable, colback=black!4, colframe=black!4, borderline west={2pt}{0pt}{black!35},
    sharp corners, boxrule=0pt, left=8pt, right=8pt, top=4pt, bottom=4pt, fontupper=\small\color{black!70}\setstretch{1.15}]
  \textbf{Guía.} #1
  \end{tcolorbox}\fi}
% Etiqueta gris para señalar los elementos de la introducción y las conclusiones
\newcommand{\etiqueta}[1]{\ifmostrarguias\par{\scriptsize\sffamily\bfseries\color{black!50}\MakeUppercase{#1}}\par\nopagebreak\vspace{-0.6\baselineskip}\fi}

